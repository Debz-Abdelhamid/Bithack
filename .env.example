APP_NAME=Patrimo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# English-first UI (project-owner decision 2026-07-05); fr/ar reserved for
# future localization passes. Timestamps display in university local time.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Algiers

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL runs in Docker only (service name: postgres) — never on the host.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=patrimo
DB_USERNAME=patrimo
DB_PASSWORD=change-me

# Redis backs sessions, cache, queues and rate limiting (service name: redis).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true behind HTTPS (production).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Realtime notifications: self-hosted Laravel Reverb (Claude.md §3).
# Replace id/key/secret with your own random values (any long random strings).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=change-me-random-digits
REVERB_APP_KEY=change-me-random-key
REVERB_APP_SECRET=change-me-random-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_APP_RATE_LIMITING_ENABLED=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev: Mailpit catches all outgoing mail — UI at http://localhost:8025.
# TODO(confirm): university SMTP credentials for production.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="patrimoine@univ-annaba.dz"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
